{
  "camera_type": "gphoto",
  "has_flash": false,
  "has_button": true,
  "disable_watchdog": false,
  "debug": false,
  "button_port_name": "/dev/ttyUSB",
  "image_dir": "/tmp",
  "show_led_setup": true,
  "force_image_dir_mountpoint": 0,
  "fullscreen": false,
  "power_off_on_exit": false,
  "print_decision_millis": 8000,
  "print_options": {
    "media": "om_postcard.borderless_100x148mm",
    "print-scaling": "fill",
    "print-color-mode": "color"
  }
}
